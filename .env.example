# Municipal Crowd-Report Verification & Confidence Dashboard
# Environment configuration. Copy to `.env` and adjust for your deployment.

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# SQLite (default — local development, no server required):
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (production — set these and switch the Prisma provider):
# DATABASE_URL="postgresql://crowduser:crowdpass@localhost:5432/crowdverif?schema=public"
# In prisma/schema.prisma change: datasource db { provider = "postgresql" }

# ----------------------------------------------------------------------------
# Session / Auth (demo cookie session)
# ----------------------------------------------------------------------------
# HMAC secret for signing the role-session cookie. CHANGE THIS IN PRODUCTION.
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ----------------------------------------------------------------------------
# Evidence storage
# ----------------------------------------------------------------------------
# Files are stored outside /public for security (served via /api/uploads/evidence).
# Defaults to <project>/storage/evidence. Override only if you need a custom path.
# EVIDENCE_STORAGE_DIR="/var/lib/crowdverif/evidence"

# ----------------------------------------------------------------------------
# Correlation thresholds (optional overrides)
# ----------------------------------------------------------------------------
# Incident grouping: same category+issueType, within this distance & time
# INCIDENT_DISTANCE_THRESHOLD_METERS=200
# INCIDENT_TIME_THRESHOLD_MINUTES=60
# Duplicate detection: same category+issueType, within this distance & time
# DUPLICATE_DISTANCE_THRESHOLD_METERS=25
# DUPLICATE_TIME_THRESHOLD_MINUTES=10

# ----------------------------------------------------------------------------
# Upload limits
# ----------------------------------------------------------------------------
# Max evidence file size in bytes (default 10 MB)
# MAX_EVIDENCE_SIZE=10485760
